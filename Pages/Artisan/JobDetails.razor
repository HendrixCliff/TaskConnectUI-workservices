
@page "/artisan/job/{Id:guid}"

@attribute [Authorize(Roles = "Artisan")]
@layout ArtisanLayout

@using Microsoft.AspNetCore.Authorization
@using WorkServices.Web.Features.JobAssignments
@using WorkServices.Web.Features.JobAssignments.Models
@using WorkServices.Web.Layout

@inject JobAssignmentService JobAssignmentService

<PageTitle>Job Details | WorkServices</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <a href="/artisan/jobs" class="text-decoration-none">
            &larr; Back to My Jobs
        </a>
        <h1 class="mt-3">Job Details</h1>
    </div>

    @if (Busy)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading job...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">
            @Error
        </div>
    }
    else if (Request is not null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="h4">
                        @(string.IsNullOrWhiteSpace(Request.ServiceType)
                            ? "Service Request"
                            : Request.ServiceType)
                    </h2>

                    <span class="badge bg-secondary">
                        @DisplayStatus(Request)
                    </span>
                </div>

               <div class="mb-3">
                <h3 class="h6 text-muted">Customer's description</h3>

                @if (string.IsNullOrWhiteSpace(Request.Description))
                {
                    <p class="text-muted">No description was provided.</p>
                }
                else
                {
                    <p class="mb-0">@Request.Description</p>
                }
            </div>

                <dl class="row mt-4">
                    <dt class="col-sm-3">Address</dt>
                    <dd class="col-sm-9">@Request.Address</dd>

                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Request.CustomerName)
                            ? "Customer details unavailable"
                            : Request.CustomerName)
                    </dd>

                    <dt class="col-sm-3">Estimated cost</dt>
                    <dd class="col-sm-9">
                        @if (Request.EstimatedCost > 0)
                        {
                            @Request.EstimatedCost.ToString("N2")
                        }
                        else
                        {
                            <span>Not provided</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Acceptance</dt>
                    <dd class="col-sm-9">
                        @(Request.Accepted ? "Accepted" : "Awaiting acceptance")
                    </dd>
                </dl>

                
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button"
                        class="btn btn-success"
                        disabled="@(Busy || Request.Accepted)"
                        @onclick="AcceptAsync">
                    Accept
                </button>

                <button type="button"
                        class="btn btn-outline-danger"
                        disabled="@(Busy || Request.Accepted)"
                        @onclick="RejectAsync">
                    Reject
                </button>

                <button type="button"
                        class="btn btn-primary"
                        disabled="@Busy"
                        @onclick="StartAsync">
                    Start Job
                </button>

                <button type="button"
                        class="btn btn-dark"
                        disabled="@Busy"
                        @onclick="CompleteAsync">
                    Complete Job
                </button>

               
                        <a class="btn btn-outline-primary"
                        href="@($"/artisan/job/{Request.ServiceRequestId}/quote")">
                            <i class="bi bi-file-earmark-text me-1"></i>
                            Create Quote
                        </a>
                   
            </div>


                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="alert alert-success mt-3" role="status">
                        @Message
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ArtisanJobDto? Request;
    private bool Busy = true;
    private string? Error;
    private string? Message;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            var jobs = await JobAssignmentService.GetMyJobsAsync();

            Request = jobs.FirstOrDefault(job => job.AssignmentId == Id);

            if (Request is null)
            {
                Error = "This assignment was not found in your jobs.";
            }
        }
        catch (HttpRequestException)
        {
            Request = null;
            Error = "Unable to load this job.";
        }
        catch (System.Text.Json.JsonException)
        {
            Request = null;
            Error = "The job response could not be read.";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task AcceptAsync() =>
        await UpdateAssignmentAsync("accept");

    private async Task RejectAsync() =>
        await UpdateAssignmentAsync("reject");

    private async Task StartAsync() =>
        await UpdateAssignmentAsync("start");

    private async Task CompleteAsync() =>
        await UpdateAssignmentAsync("complete");

    private async Task UpdateAssignmentAsync(string action)
    {
        if (Request is null || Busy)
        {
            return;
        }

        Busy = true;
        Error = null;
        Message = null;

        try
        {
           switch (action)
          {
            case "accept":
                await JobAssignmentService.AcceptAsync(
                    Request.AssignmentId);
                break;

            case "reject":
                await JobAssignmentService.RejectAsync(
                    Request.AssignmentId);
                break;

            case "start":
                await JobAssignmentService.StartAsync(
                    Request.ServiceRequestId);
                break;

            case "complete":
                await JobAssignmentService.CompleteAsync(
                    Request.ServiceRequestId);
                break;

            default:
                throw new InvalidOperationException(
                    "Unsupported job action.");
        }

            Message = $"Job {action} action completed successfully.";

            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Error = $"Unable to {action} this job. Check the assignment status and permissions.";
        }
        finally
        {
            Busy = false;
        }
    }

    private static string DisplayStatus(ArtisanJobDto job) =>
        !string.IsNullOrWhiteSpace(job.Status)
            ? job.Status
            : job.Accepted ? "Accepted" : "Awaiting acceptance";
}
