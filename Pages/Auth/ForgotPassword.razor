@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using WorkServices.Web.Services
@attribute [AllowAnonymous]

@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Forgot Password</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="mb-2">Forgot your password?</h2>
                    <p class="text-muted mb-4">
                        Enter the email address associated with your account.
                        If an account exists, we will send you a password reset link.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }

                    @if (Submitted)
                    {
                        <div class="alert alert-success" role="status">
                            If an account exists for that email address, a password
                            reset link will be sent shortly. Please check your inbox.
                        </div>

                        <button type="button"
                                class="btn btn-primary w-100"
                                @onclick="GoToLogin">
                            Return to Login
                        </button>
                    }
                    else
                    {
                        <EditForm Model="Model" OnValidSubmit="SubmitAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="email" class="form-label">Email address</label>
                                <InputText id="email"
                                           class="form-control"
                                           type="email"
                                           autocomplete="email"
                                           placeholder="you@example.com"
                                           @bind-Value="Model.Email" />
                                <ValidationMessage For="@(() => Model.Email)" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    disabled="@IsSubmitting">
                                @if (IsSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"
                                          role="status"
                                          aria-hidden="true"></span>
                                    <span>Sending...</span>
                                }
                                else
                                {
                                    <span>Send Reset Link</span>
                                }
                            </button>
                        </EditForm>

                        <div class="text-center mt-4">
                            <a href="/login">Back to Login</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly ForgotPasswordModel Model = new();

    private bool IsSubmitting;
    private bool Submitted;
    private string? ErrorMessage;

    private async Task SubmitAsync()
    {
        if (IsSubmitting)
            return;

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            await Api.PostAsync(
                "auth/forgot-password",
                new
                {
                    Email = Model.Email.Trim()
                });

            // Deliberately use the same message whether or not the account exists.
            Submitted = true;
        }
        catch (Exception)
        {
            ErrorMessage =
                "We couldn't process your request right now. Please try again later.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}