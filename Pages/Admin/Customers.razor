
@page "/admin/customers"
@attribute [Authorize(Roles = "Admin")]

@inject ApiClient Api

<PageTitle>Manage Customers</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Customers</h1>
            <p class="text-muted">Manage registered customers.</p>
        </div>

        <button class="btn btn-outline-primary"
                @onclick="LoadCustomersAsync"
                disabled="@Busy">
            Refresh
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger">@Error</div>
    }

    @if (Busy)
    {
        <p>Loading customers...</p>
    }
    else
    {
        <div class="card p-3 mb-3">
            <strong>Total customers: @_customers.Count</strong>
        </div>

        @if (_customers.Count == 0)
        {
            <div class="alert alert-info">
                No customers were found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in _customers)
                        {
                            <tr @key="customer.Id">
                                <td>@customer.FullName</td>
                                <td>@customer.Email</td>
                                <td>@(customer.PhoneNumber ?? "—")</td>
                                <td>@(customer.Status ?? "Unknown")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private List<AdminUserDto> _customers = [];
    private bool Busy = true;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            var result = await Api.GetAsync<List<AdminUserDto>>(
                "admin/customers");

            _customers = result ?? [];
        }
        catch (Exception)
        {
            _customers = [];
            Error = "Unable to load customers. Check the API endpoint and your administrator permissions.";
        }
        finally
        {
            Busy = false;
        }
      }
    }