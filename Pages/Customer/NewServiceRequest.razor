@page "/customer/request/new"

@attribute [Authorize(Roles = "Customer")]
@layout CustomerLayout

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using WorkServices.Web.Auth
@using WorkServices.Web.Features.ServiceRequests
@using WorkServices.Web.Features.ServiceRequests.Models
@using WorkServices.Web.Layout

@inject ServiceRequestService ServiceRequestService
@inject WorkServicesAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Request a Service | WorkServices</PageTitle>

<div class="container-fluid p-4">
    <div class="mb-4">
        <h1>Request a Service</h1>
        <p class="text-muted">
            Tell us what work you need done.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <EditForm Model="@model" OnValidSubmit="@SubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="serviceType" class="form-label">
                        Service Type
                    </label>

                    <InputSelect id="serviceType"
                                 @bind-Value="model.ServiceType"
                                 class="form-select">
                        <option value="0">-- Select a service --</option>
                        <option value="1">Plumbing</option>
                        <option value="2">Electrical</option>
                        <option value="3">Carpentry</option>
                        <option value="4">Cleaning</option>
                        <option value="5">Laundry</option>
                        <option value="6">Painting</option>
                        <option value="7">Generator Repair</option>
                    </InputSelect>

                    <ValidationMessage For="@(() => model.ServiceType)" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">
                        Describe the work
                    </label>

                    <InputTextArea id="description"
                                   @bind-Value="model.Description"
                                   class="form-control"
                                   rows="5" />

                    <ValidationMessage For="@(() => model.Description)" />
                </div>

                <div class="mb-4">
                    <label for="address" class="form-label">
                        Service Address
                    </label>

                    <InputText id="address"
                               @bind-Value="model.Address"
                               class="form-control" />

                    <ValidationMessage For="@(() => model.Address)" />
                </div>

                <button class="btn btn-primary"
                        type="submit"
                        disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              aria-hidden="true"></span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit Request</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private readonly FormModel model = new();

    private bool isSubmitting;
    private string errorMessage = string.Empty;

    private async Task SubmitAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authenticationState.User;

            var customerIdClaim =
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!Guid.TryParse(customerIdClaim, out var customerId))
            {
                errorMessage =
                    "Your authenticated user ID could not be determined.";
                return;
            }

            var request = new CreateServiceRequestRequest
            {
                CustomerId = customerId,
                ServiceType = model.ServiceType,
                Description = model.Description.Trim(),
                Address = model.Address.Trim()
            };

            
            await ServiceRequestService.CreateAsync(request);

           
            NavigationManager.NavigateTo("/customer/requests");
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Unable to submit your request. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class FormModel
    {
        [Range(1, 7, ErrorMessage = "Please select a service type.")]
        public int ServiceType { get; set; }

        [Required(ErrorMessage = "Please describe the work you need.")]
        [MinLength(10, ErrorMessage = "Please provide a little more detail.")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please provide the service address.")]
        public string Address { get; set; } = string.Empty;
    }
}
