
@page "/customer"
@attribute [Authorize(Roles = "Customer")]
@layout CustomerLayout

@using Microsoft.AspNetCore.Authorization
@using WorkServices.Web.Features.ServiceRequests
@using WorkServices.Web.Features.ServiceRequests.Models
@using WorkServices.Web.Layout

@inject ServiceRequestService ServiceRequestService

<PageTitle>Customer Dashboard | WorkServices</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1>Customer Dashboard</h1>
            <p class="text-muted mb-0">
                Manage your service requests and jobs.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
        <NavLink href="/customer/quotes" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-text me-1"></i>
            My Quotes
        </NavLink>

        <NavLink href="/customer/request/new" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Request a Service
        </NavLink>
    </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2">Loading your dashboard...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage

            <button class="btn btn-sm btn-outline-danger ms-3"
                    @onclick="LoadDashboardAsync">
                Try again
            </button>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted">Active Requests</div>
                        <div class="fs-2 fw-bold">@ActiveRequests</div>
                        <small class="text-muted">
                            Requests not yet completed or cancelled
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted">Awaiting Action</div>
                        <div class="fs-2 fw-bold">@AwaitingAction</div>
                        <small class="text-muted">
                            Requests awaiting the next step
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted">Completed</div>
                        <div class="fs-2 fw-bold">@CompletedRequests</div>
                        <small class="text-muted">
                            Successfully completed jobs
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 mb-1">Recent Requests</h2>
                        <p class="text-muted mb-0">
                            Review the latest activity on your jobs.
                        </p>
                    </div>

                    <a href="/customer/requests"
                       class="btn btn-outline-primary">
                        View All Requests
                    </a>
                </div>

                @if (requests.Count == 0)
                {
                    <div class="text-center py-5">
                        <h3 class="h5">No service requests yet</h3>
                        <p class="text-muted">
                            Tell us what work you need help with.
                        </p>
                        <a href="/customer/request/new"
                           class="btn btn-primary">
                            Create Your First Request
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Service</th>
                                    <th>Address</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in RecentRequests)
                                {
                                    <tr @key="request.Id">
                                        <td>@FormatServiceType(request.ServiceType)</td>
                                        <td>@request.Address</td>
                                        <td>
                                            <span class="@GetStatusCssClass(request.Status)">
                                                @FormatStatus(request.Status)
                                            </span>
                                        </td>
                                        <td>
                                            <a href="@($"/customer/request/{request.Id}")"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<CustomerRequestDto> requests = [];
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    private int ActiveRequests =>
        requests.Count(request =>
            !IsStatus(request, "Completed") &&
            !IsStatus(request, "Reviewed") &&
            !IsStatus(request, "Cancelled"));

    private int AwaitingAction =>
        requests.Count(request =>
            IsStatus(request, "Pending") ||
            IsStatus(request, "QuoteSubmitted"));

    private int CompletedRequests =>
        requests.Count(request =>
            IsStatus(request, "Completed") ||
            IsStatus(request, "Reviewed"));

    private IEnumerable<CustomerRequestDto> RecentRequests =>
        requests.Take(5);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            requests = await ServiceRequestService.GetMyAsync() ?? [];
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Unable to load your requests. Please check your connection and try again.";
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage =
                "Your session may have expired. Please sign in again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool IsStatus(
        CustomerRequestDto request,
        string expectedStatus)
    {
        return string.Equals(
            request.Status,
            expectedStatus,
            StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatServiceType(string serviceType)
    {
        return serviceType switch
        {
            "GeneratorRepair" => "Generator Repair",
            _ => serviceType
        };
    }

    private static string FormatStatus(string status)
    {
        return status switch
        {
            "InProgress" => "In Progress",
            _ => status
        };
    }

    private static string GetStatusCssClass(string status)
    {
        return status switch
        {
            "Pending" => "badge bg-warning text-dark",
            "Assigned" => "badge bg-info text-dark",
            "Reviewed" => "badge bg-primary",
            "InProgress" => "badge bg-primary",
            "Completed" => "badge bg-success",
            "Cancelled" => "badge bg-secondary",
            "Rejected" => "badge bg-danger",
            _ => "badge bg-secondary"
        };
    }
}
