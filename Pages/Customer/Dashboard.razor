@page "/customer"

@attribute [Authorize(Roles = "Customer")]

@layout CustomerLayout

@using Microsoft.AspNetCore.Authorization
@using WorkServices.Web.Layout;

<PageTitle>Customer Dashboard | WorkServices</PageTitle>

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Customer Dashboard</h1>

            <p class="text-muted mb-0">
                Manage your service requests and jobs.
            </p>
        </div>

        <a href="/customer/request/new"
           class="btn btn-primary">
            + Request a Service
        </a>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">
                        Active Requests
                    </div>

                    <div class="fs-2 fw-bold">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">
                        Awaiting Action
                    </div>

                    <div class="fs-2 fw-bold">
                        0
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">
                        Completed
                    </div>

                    <div class="fs-2 fw-bold">
                        0
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>