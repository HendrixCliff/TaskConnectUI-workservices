@page "/customer/requests/{Id:guid}"
@attribute [Authorize(Roles = "Customer")]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Request Details</PageTitle>

<div class="container py-4">
    <h1>Service request</h1>

    @if (Busy)
    {
        <p>Loading request...</p>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger">@Error</div>
    }
    else if (Request is not null)
    {
        <div class="card p-4">
            <div class="d-flex justify-content-between flex-wrap gap-2">
                <h2>@Request.Description</h2>
                <StatusBadge Status="Request.Status" />
            </div>

            <dl class="row mt-3">
                <dt class="col-sm-3">Request ID</dt>
                <dd class="col-sm-9">@Request.Id</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Request.Address</dd>

                <dt class="col-sm-3">Service type</dt>
                <dd class="col-sm-9">@Request.ServiceType</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Request.CreatedAt.ToLocalTime().ToString("g")</dd>

                <dt class="col-sm-3">Artisan</dt>
                <dd class="col-sm-9">@(Request.ArtisanName ?? "Not assigned")</dd>
            </dl>

            
            <div class="d-flex gap-2 flex-wrap">
                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="ViewQuote">
                    View quote
                </button>

                @if (Request.Status == JobStatus.LabourPaid)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="WriteReview">
                        Review artisan
                    </button>
                }
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ServiceRequestDto? Request;
    private bool Busy = true;
    private string? Error;

    protected override async Task OnParametersSetAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            Request = await Api.GetAsync<ServiceRequestDto>(
                $"service-requests/{Id}");

            if (Request is null)
                Error = "Request not found.";
        }
        catch (ApiException ex)
        {
            Error = ex.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "Request not found."
                : "Unable to load this request.";
        }
        catch
        {
            Error = "Unable to contact the server.";
        }
        finally
        {
            Busy = false;
        }
    }

    private void ViewQuote() =>
        Navigation.NavigateTo($"/customer/quotes/{Id}");

    private void WriteReview() =>
        Navigation.NavigateTo(
            $"/customer/review/{Id}?artisanId={Request?.ArtisanId}");
}


