
@page "/customer/requests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Customer")]
@layout CustomerLayout

@using WorkServices.Web.Features.ServiceRequests
@using WorkServices.Web.Features.ServiceRequests.Models
@using WorkServices.Web.Layout

@inject ServiceRequestService ServiceRequestService

<PageTitle>My Requests | WorkServices</PageTitle>

<div class="container py-4">
    <h2 class="mb-4">My Job Requests</h2>

    @if (isLoading)
    {
        <p>Loading your requests...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (requests.Count == 0)
    {
        <div class="alert alert-info">
            No job requests were found for your account.
        </div>
    }
    else
    {
        <p>Requests loaded: @requests.Count</p>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th>Request ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in requests)
                    {
                        <tr @key="request.Id">
                            <td>@request.ServiceType</td>
                            <td>@request.Address</td>
                            <td>
                                <span class="@GetStatusClass(request.Status)">
                                    @request.Status
                                </span>
                            </td>
                            <td>
                                <small>@request.Id</small>
                            </td>
                            
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                href="@($"/customer/quotes/{request.Id}")">
                                    <i class="bi bi-file-earmark-text me-1"></i>
                                    View Quote
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<CustomerRequestDto> requests = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            requests = await ServiceRequestService.GetMyAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load requests: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "badge bg-warning text-dark",
            "Assigned" => "badge bg-info text-dark",
            "Reviewed" => "badge bg-primary",
            "InProgress" => "badge bg-primary",
            "Completed" => "badge bg-success",
            "Cancelled" => "badge bg-secondary",
            "Rejected" => "badge bg-danger",
            _ => "badge bg-secondary"
        };
    }
}
