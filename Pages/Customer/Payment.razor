
@page "/customer/payment/{ServiceRequestId:guid}"

@using Microsoft.AspNetCore.Authorization
@using WorkServices.Web.Features.Payments
@using WorkServices.Web.Features.Payments.Models

@attribute [Authorize(Roles = "Customer")]

@inject PaymentService PaymentService
@inject NavigationManager Navigation

<PageTitle>Payment</PageTitle>

<div class="container py-4">
    <h1>Payment</h1>
    <p class="text-muted">
        Review the payments associated with this service request.
    </p>

    @if (Busy)
    {
        <p><span class="spinner-border spinner-border-sm me-2"></span>Loading payment details...</p>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">@Error</div>
    }

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-info" role="status">@Message</div>
    }

    @if (!Busy && _payments.Count == 0 && string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-secondary">
            No payments were found for this service request.
        </div>
    }

    @if (_payments.Count > 0)
    {
        <div class="row g-3">
            @foreach (var payment in _payments)
            {
                <div class="col-12" @key="payment.Id">
                    <div class="card p-4">
                        <h2 class="h5">Payment details</h2>

                        <dl class="row mt-3 mb-3">
                            <dt class="col-sm-4">Payment ID</dt>
                            <dd class="col-sm-8">@payment.Id</dd>

                            <dt class="col-sm-4">Reference</dt>
                            <dd class="col-sm-8">
                                @(payment.Reference ?? "Not assigned")
                            </dd>

                            <dt class="col-sm-4">Amount</dt>
                            <dd class="col-sm-8">
                                @payment.Amount.ToString("N2")
                            </dd>

                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8">
                                @(payment.Status ?? "Unknown")
                            </dd>
                        </dl>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-primary"
                                    disabled="@Busy"
                                    @onclick="() => InitializePaymentAsync(payment.Id)">
                                Continue to payment
                            </button>

                            @if (!string.IsNullOrWhiteSpace(payment.Reference))
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        disabled="@Busy"
                                        @onclick="() => VerifyPaymentAsync(payment.Reference!)">
                                    Verify payment
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid ServiceRequestId { get; set; }

    private List<PaymentDto> _payments = [];
    private bool Busy;
    private string? Error;
    private string? Message;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            _payments = await PaymentService.GetByServiceRequestAsync(
                ServiceRequestId);
        }
        catch (HttpRequestException)
        {
            Error = "Unable to load payments for this service request.";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task InitializePaymentAsync(Guid paymentId)
    {
        Busy = true;
        Error = null;
        Message = null;

        try
        {
            var result = await PaymentService.InitializeAsync(paymentId);

            if (result is null ||
                !Uri.TryCreate(
                    result.AuthorizationUrl,
                    UriKind.Absolute,
                    out var paymentUri) ||
                paymentUri.Scheme != Uri.UriSchemeHttps)
            {
                Error = "The payment provider did not return a valid HTTPS payment URL.";
                return;
            }

            Navigation.NavigateTo(paymentUri.AbsoluteUri, forceLoad: true);
        }
        catch (HttpRequestException)
        {
            Error = "Unable to initialize payment. Please try again.";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task VerifyPaymentAsync(string reference)
    {
        if (string.IsNullOrWhiteSpace(reference))
        {
            Error = "A payment reference is required.";
            return;
        }

        Busy = true;
        Error = null;
        Message = null;

        try
        {
            var result = await PaymentService.VerifyAsync(reference);

            Message = result?.Message ?? "Payment verification completed.";
            await LoadPaymentsAsync();
        }
        catch (HttpRequestException)
        {
            Error = "Unable to verify payment. Please try again.";
        }
        finally
        {
            Busy = false;
        }
    }
}
