
@page "/customer/payment/{ServiceRequestId:guid}"

@using Microsoft.AspNetCore.Authorization
@using WorkServices.Web.Features.Payments
@using WorkServices.Web.Features.Payments.Models
@using WorkServices.Web.Layout
@using WorkServices.Web.Services
@using System.Globalization

@attribute [Authorize(Roles = "Customer")]
@layout CustomerLayout

@inject PaymentService PaymentService
@inject NavigationManager Navigation

<PageTitle>Payments | WorkServices</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <a href="@($"/customer/requests/{ServiceRequestId}")"
           class="text-decoration-none">
            &larr; Back to service request
        </a>

        <h1 class="mt-3">Payments</h1>
        <p class="text-muted">
            View payment records and continue to secure Paystack checkout.
        </p>
    </div>

    @if (Busy)
    {
        <div class="d-flex align-items-center gap-2 py-4">
            <div class="spinner-border spinner-border-sm text-primary"
                 role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>Loading payment details...</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">
            @Error
            <button type="button"
                    class="btn btn-outline-danger btn-sm ms-2"
                    disabled="@Busy"
                    @onclick="LoadPaymentsAsync">
                Try again
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-info" role="status">
            @Message
        </div>
    }

    @if (!Busy && string.IsNullOrWhiteSpace(Error))
    {
        @if (_payments.Count == 0)
        {
            <div class="alert alert-secondary">
                No payment records exist for this request yet.
                Choose a payment type below to ask the server to initialize
                an eligible payment.
            </div>
        }
        else
        {
            <h2 class="h4 mb-3">Payment history</h2>

            <div class="row g-3">
                @foreach (var payment in _payments)
                {
                    <div class="col-12" @key="payment.PaymentId">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex flex-wrap justify-content-between
                                            align-items-start gap-2">
                                    <h3 class="h5 mb-0">
                                        @payment.Type payment
                                    </h3>

                                    <span class="@GetStatusBadgeClass(payment.Status)">
                                        @payment.Status
                                    </span>
                                </div>

                                <dl class="row mt-3 mb-3">
                                    <dt class="col-sm-4">Amount</dt>
                                    <dd class="col-sm-8 fw-bold">
                                        @payment.Amount.ToString("C2", NairaCulture)
                                    </dd>

                                    <dt class="col-sm-4">Payment ID</dt>
                                    <dd class="col-sm-8 text-break">
                                        @payment.PaymentId
                                    </dd>

                                    <dt class="col-sm-4">Reference</dt>
                                    <dd class="col-sm-8 text-break">
                                        @(string.IsNullOrWhiteSpace(payment.Reference)
                                            ? "Not assigned"
                                            : payment.Reference)
                                    </dd>
                                </dl>

                                @if (IsPending(payment.Status))
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button"
                                                class="btn btn-primary"
                                                disabled="@Busy"
                                                @onclick="() => InitializePaymentAsync(payment.Type)">
                                            Continue to payment
                                        </button>

                                        @if (!string.IsNullOrWhiteSpace(payment.Reference))
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    disabled="@Busy"
                                                    @onclick="() => VerifyPaymentAsync(payment.Reference)">
                                                Verify payment
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4">
            <h2 class="h4">Start a payment</h2>

            <p class="text-muted">
                Payment amounts are calculated by the server from your
                approved quote. Only payments allowed by the current job
                status can be initialized.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@Busy"
                        @onclick="PayForMaterialsAsync">
                    Pay for materials
                </button>

                <button type="button"
                        class="btn btn-outline-primary"
                        disabled="@Busy"
                        @onclick="PayForLabourAsync">
                    Pay for labour
                </button>
            </div>

            <small class="text-muted d-block mt-3">
                Materials payment requires an approved quote. Labour payment
                requires the job to be completed.
            </small>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid ServiceRequestId { get; set; }

    private static readonly CultureInfo NairaCulture =
        CultureInfo.GetCultureInfo("en-NG");

    private List<PaymentDto> _payments = [];
    private bool Busy;
    private string? Error;
    private string? Message;

    protected override async Task OnParametersSetAsync()
    {
        if (ServiceRequestId == Guid.Empty)
        {
            Error = "A valid service request is required.";
            return;
        }

        await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        Busy = true;
        Error = null;

        try
        {
            _payments = await PaymentService.GetByServiceRequestAsync(
                ServiceRequestId);
        }
        catch (ApiException ex)
        {
            Error = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized =>
                    "Your session has expired. Please sign in again.",

                System.Net.HttpStatusCode.Forbidden =>
                    "You are not authorized to view these payments.",

                System.Net.HttpStatusCode.NotFound =>
                    "The service request or payment records could not be found.",

                _ => "Unable to load payment details. Please try again."
            };
        }
        catch (HttpRequestException)
        {
            Error = "Unable to connect to the server.";
        }
        catch (Exception)
        {
            Error = "An unexpected error occurred while loading payments.";
        }
        finally
        {
            Busy = false;
        }
    }

    private Task PayForMaterialsAsync() =>
        InitializePaymentAsync("Material");

    private Task PayForLabourAsync() =>
        InitializePaymentAsync("Labour");

    private async Task InitializePaymentAsync(string paymentType)
    {
        if (Busy)
            return;

        if (paymentType is not ("Material" or "Labour"))
        {
            Error = "Unsupported payment type.";
            return;
        }

        Busy = true;
        Error = null;
        Message = null;

        try
        {
            var type = paymentType == "Material"
                ? PaymentType.Material
                : PaymentType.Labour;

            var checkoutUrl = await PaymentService.InitializePaymentAsync(
                ServiceRequestId,
                type);

            if (!Uri.TryCreate(
                    checkoutUrl,
                    UriKind.Absolute,
                    out var paymentUri)
                || paymentUri.Scheme != Uri.UriSchemeHttps
                || !string.Equals(
                    paymentUri.Host,
                    "checkout.paystack.com",
                    StringComparison.OrdinalIgnoreCase))
            {
                Error = "The server returned an invalid payment checkout URL.";
                return;
            }

            Navigation.NavigateTo(paymentUri.AbsoluteUri, forceLoad: true);
        }
        catch (ApiException ex)
        {
            Error = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized =>
                    "Please sign in again to make a payment.",

                System.Net.HttpStatusCode.Forbidden =>
                    "You are not authorized to make this payment.",

                System.Net.HttpStatusCode.BadRequest =>
                    "This payment is not currently allowed. Check the quote approval and job status.",

                System.Net.HttpStatusCode.NotFound =>
                    "The service request or approved quote could not be found.",

                _ => "Unable to initialize payment. Please try again."
            };
        }
        catch (HttpRequestException)
        {
            Error = "Unable to connect to the payment service.";
        }
        catch (InvalidOperationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception)
        {
            Error = "An unexpected error occurred while starting payment.";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task VerifyPaymentAsync(string reference)
    {
        if (Busy || string.IsNullOrWhiteSpace(reference))
            return;

        Busy = true;
        Error = null;
        Message = null;

        try
        {
            var result = await PaymentService.VerifyAsync(reference);

            Message = result?.Message ?? "Payment verification completed.";

            await LoadPaymentsAsync();
        }
        catch (ApiException ex)
        {
            Error = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized =>
                    "Please sign in again to verify payment.",

                System.Net.HttpStatusCode.Forbidden =>
                    "You are not authorized to verify this payment.",

                System.Net.HttpStatusCode.BadRequest =>
                    "The payment has not been confirmed as successful.",

                System.Net.HttpStatusCode.NotFound =>
                    "The payment reference could not be found.",

                _ => "Unable to verify payment. Please try again."
            };
        }
        catch (HttpRequestException)
        {
            Error = "Unable to connect while verifying payment.";
        }
        catch (Exception)
        {
            Error = "An unexpected error occurred while verifying payment.";
        }
        finally
        {
            Busy = false;
        }
    }

    private static bool IsPending(string? status) =>
        string.Equals(
            status,
            "Pending",
            StringComparison.OrdinalIgnoreCase);

    private static string GetStatusBadgeClass(string? status)
    {
        if (string.Equals(status, "Pending",
                StringComparison.OrdinalIgnoreCase))
            return "badge bg-warning text-dark";

        if (string.Equals(status, "MaterialPaid",
                StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "LabourPaid",
                StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Successful",
                StringComparison.OrdinalIgnoreCase))
            return "badge bg-success";

        return "badge bg-secondary";
    }
}
