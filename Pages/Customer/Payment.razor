@page "/customer/payment/{PaymentId:guid}"
@attribute [Authorize(Roles = "Customer")]

@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Payment</PageTitle>

<div class="container py-4">
    <h1>Payment</h1>

    @if (Busy)
    {
        <p>Loading payment details...</p>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger">@Error</div>
    }
    else if (_payment is not null)
    {
        <div class="card p-4">
            <h2>Payment details</h2>

            <dl class="row mt-3">
                <dt class="col-sm-4">Payment reference</dt>
                <dd class="col-sm-8">
                    @(_payment.Reference ?? _payment.Id.ToString())
                </dd>

                <dt class="col-sm-4">Amount</dt>
                <dd class="col-sm-8">
                    @_payment.Amount.ToString("N2")
                </dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @(_payment.Status ?? "Unknown")
                </dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="alert alert-info">@Message</div>
            }

            <div class="d-flex flex-wrap gap-2">
                @if (!string.IsNullOrWhiteSpace(_payment.AuthorizationUrl))
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="OpenPaymentPage">
                        Continue to payment
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@Busy"
                        @onclick="VerifyAsync">
                    Verify payment
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid PaymentId { get; set; }

    private PaymentDto? _payment;
    private bool Busy = true;
    private string? Error;
    private string? Message;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPaymentAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender &&
            string.Equals(
                GetQueryParameter("status"),
                "success",
                StringComparison.OrdinalIgnoreCase))
        {
            await VerifyAsync();
        }
    }

    private async Task LoadPaymentAsync()
    {
        Busy = true;
        Error = null;
        Message = null;

        try
        {
            _payment = await Api.GetAsync<PaymentDto>(
                $"payments/{PaymentId}");

            if (_payment is null)
            {
                Error = "Payment not found.";
            }
        }
        catch (Exception)
        {
            _payment = null;
            Error = "Unable to load this payment. Verify the payment endpoint and payment ID.";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task VerifyAsync()
    {
        if (Busy)
        {
            return;
        }

        Busy = true;
        Error = null;
        Message = null;

        try
        {
            _payment = await Api.GetAsync<PaymentDto>(
                $"payments/{PaymentId}/verify");

            Message = "Payment verification completed.";
        }
        catch (Exception)
        {
            Error = "Unable to verify the payment. Please try again.";
        }
        finally
        {
            Busy = false;
        }
    }

    private void OpenPaymentPage()
    {
        var url = _payment?.AuthorizationUrl;

        if (Uri.TryCreate(url, UriKind.Absolute, out var parsed) &&
            (parsed.Scheme == Uri.UriSchemeHttps ||
             parsed.Scheme == Uri.UriSchemeHttp))
        {
            Navigation.NavigateTo(parsed.AbsoluteUri, forceLoad: true);
        }
        else
        {
            Error = "The payment provider did not return a valid payment URL.";
        }
    }

    private string? GetQueryParameter(string name)
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query
            .TrimStart('?');

        foreach (var pair in query.Split(
            '&',
            StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);

            var key = Uri.UnescapeDataString(
                parts[0].Replace("+", " "));

            if (!string.Equals(
                    key,
                    name,
                    StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = parts.Length > 1 ? parts[1] : string.Empty;

            return Uri.UnescapeDataString(value.Replace("+", " "));
        }

        return null;
        }}