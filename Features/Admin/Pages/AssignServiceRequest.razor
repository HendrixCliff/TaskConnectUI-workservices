 @page "/admin/service-request/{ServiceRequestId:guid}/assign"

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using WorkServices.Web.Features.Admin.Models
@using WorkServices.Web.Features.JobAssignments
@using WorkServices.Web.Features.JobAssignments.Models
@using WorkServices.Web.Layout
@using WorkServices.Web.Services

@inject ApiClient Api
@inject JobAssignmentService JobAssignmentService
@inject NavigationManager NavigationManager

<PageTitle>Assign Artisan | WorkServices</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Assign Artisan</h1>
            <p class="text-muted mb-0">
                Select an artisan for this service request.
            </p>
        </div>

        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="GoBack">
            Back to Dashboard
        </button>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="text-muted small">Service request ID</div>
            <code>@ServiceRequestId</code>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">
            @Error
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Success))
    {
        <div class="alert alert-success" role="alert">
            @Success
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2" role="status">
            <span class="spinner-border spinner-border-sm"></span>
            <span>Loading artisans...</span>
        </div>
    }
    else if (Artisans.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            No artisans are available to display.
            @if (string.IsNullOrWhiteSpace(Error))
            {
                <span>Verify that artisans are registered and the API returned data.</span>
            }
        </div>

        <button type="button"
                class="btn btn-outline-primary"
                @onclick="LoadArtisansAsync"
                disabled="@IsSubmitting">
            Retry
        </button>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <EditForm Model="@Model" OnValidSubmit="@AssignAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="artisan" class="form-label">
                            Select artisan
                        </label>

                        <InputSelect id="artisan"
                                     class="form-select"
                                     @bind-Value="ArtisanIdText"
                                     TValue="string">
                            <option value="">-- Select an artisan --</option>

                            @foreach (var artisan in Artisans)
                            {
                                <option @key="artisan.Id"
                                        value="@artisan.Id.ToString()">
                                    @artisan.FullName (@artisan.Email)@FormatServiceType(artisan.ServiceType)
                                </option>
                            }
                        </InputSelect>

                        <div class="form-text">
                            Choose the artisan who should receive this request.
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@(IsSubmitting || string.IsNullOrWhiteSpace(ArtisanIdText))">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Assigning...</span>
                        }
                        else
                        {
                            <span>Assign Artisan</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid ServiceRequestId { get; set; }

    private readonly CreateJobAssignmentRequest Model = new();

    private List<AdminUserDto> Artisans = [];
    private string ArtisanIdText = string.Empty;
    private string? Error;
    private string? Success;
    private bool IsLoading;
    private bool IsSubmitting;

    protected override async Task OnParametersSetAsync()
    {
        if (ServiceRequestId == Guid.Empty)
        {
            Error = "The service request ID is invalid.";
            Artisans = [];
            return;
        }

        await LoadArtisansAsync();
    }

    private async Task LoadArtisansAsync()
    {
        IsLoading = true;
        Error = null;
        Artisans = [];
        ArtisanIdText = string.Empty;

        try
        {
            // Maps to GET /api/admin/artisans through ApiClient's API base URL.
            var result = await Api.GetAsync<List<AdminUserDto>>(
                "admin/artisans");

            Artisans = result ?? [];

            if (Artisans.Count == 0)
            {
                Error = "The API returned no artisans.";
            }
        }
        catch (ApiException ex)
        {
            Error = $"Unable to load artisans. API returned HTTP {(int)ex.StatusCode}.";
        }
        catch (HttpRequestException)
        {
            Error = "Unable to reach the API. Check your connection and try again.";
        }
        catch (Exception)
        {
            Error = "An unexpected error occurred while loading artisans.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AssignAsync()
    {
        Error = null;
        Success = null;

        if (ServiceRequestId == Guid.Empty)
        {
            Error = "The service request ID is invalid.";
            return;
        }

        if (!Guid.TryParse(ArtisanIdText, out var artisanId))
        {
            Error = "Please select a valid artisan.";
            return;
        }

        if (!Artisans.Any(a => a.Id == artisanId))
        {
            Error = "The selected artisan is not in the loaded artisan list. Reload the list and try again.";
            return;
        }

        IsSubmitting = true;

        try
        {
            Model.ServiceRequestId = ServiceRequestId;
            Model.ArtisanId = artisanId;

            await JobAssignmentService.AssignAsync(Model);

            Success = "The artisan was assigned successfully.";
            ArtisanIdText = string.Empty;
        }
        catch (ApiException ex)
        {
            Error = $"Assignment failed. API returned HTTP {(int)ex.StatusCode}.";
        }
        catch (HttpRequestException)
        {
            Error = "Unable to reach the API while assigning the artisan.";
        }
        catch (Exception)
        {
            Error = "An unexpected error occurred while assigning the artisan.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/admin");
    }

    private static string FormatServiceType(string? serviceType)
    {
        return string.IsNullOrWhiteSpace(serviceType)
            ? string.Empty
            : $" — {serviceType}";
    }
}